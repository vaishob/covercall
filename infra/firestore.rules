rules_version = '2';
// (default) database. Clients (the web app) get READ-ONLY access to the demo tenant's public
// collections and no writes anywhere. Server-only collections (offers with callback URLs,
// approvals, replies_raw, quarantine, inputs, server, dedup, outbound, applied, offer_keys)
// are not readable by clients. Services use IAM, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /gaps/{gapId} {
      allow read: if true;
      allow write: if false;
      match /events/{seq} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }
    match /outlets/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /shifts/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
