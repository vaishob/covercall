rules_version = '2';
// (default) database: NO client access at all (docs/decisions/0015-reads-through-api.md).
// The web app reads only through api's client-safe projections. Services use IAM service
// accounts, which bypass these rules. All data is synthetic.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
