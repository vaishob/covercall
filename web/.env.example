# CoverCall Web Frontend Environment Configuration (§8.1, §11.1, §12.1)
# No secrets are ever placed in the browser client.
# When VITE_API_BASE_URL is unset, the web app runs in Mock Mode (MockDataSource).

VITE_API_BASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID="(default)"
VITE_GEMINI_LIVE_MODEL_ID=""
